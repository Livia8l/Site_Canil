# Ambiente de desenvolvimento — SQLite local, zero configuração.
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar a sessão do painel administrativo (JWT).
# Em produção, gerar um valor aleatório forte e manter em segredo.
SESSION_SECRET="troque-este-valor-em-producao-para-uma-string-aleatoria-longa"

# Usados apenas pelo script de seed para criar o primeiro administrador.
# Depois do primeiro login, recomenda-se alterar a senha e remover estas
# variáveis do arquivo .env (ou do provedor de hospedagem).
ADMIN_NOME="Responsável Family Pom's"
ADMIN_EMAIL="admin@familypoms.com.br"
ADMIN_SENHA="TrocarSenha123!"
